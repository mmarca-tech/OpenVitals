opt_out_usage

default_platform(:android)

require "pathname"

OPENVITALS_PACKAGE_NAME = "tech.mmarca.openvitals"
OPENVITALS_METADATA_PATH = "fastlane/metadata/android"
OPENVITALS_PROJECT_ROOT = File.expand_path("..", __dir__)

def openvitals_project_path(path)
  value = path.to_s
  return value if value.empty?

  pathname = Pathname.new(value)
  pathname.absolute? ? value : File.expand_path(value, OPENVITALS_PROJECT_ROOT)
end

platform :android do
  desc "Upload the signed nightly Android App Bundle to Google Play open testing"
  lane :open_testing do |options|
    json_key = options[:json_key] || ENV["GOOGLE_PLAY_JSON_KEY"]
    aab = options[:aab] || ENV["OPENVITALS_NIGHTLY_AAB"]
    version_code = options[:version_code] || ENV["OPENVITALS_VERSION_CODE"]

    UI.user_error!("json_key is required") if json_key.to_s.empty?
    UI.user_error!("aab is required") if aab.to_s.empty?

    json_key = openvitals_project_path(json_key)
    aab = openvitals_project_path(aab)

    UI.user_error!("aab does not exist: #{aab}") unless File.file?(aab)

    if version_code.to_s.length > 0
      existing_codes = google_play_track_version_codes(
        package_name: OPENVITALS_PACKAGE_NAME,
        json_key: json_key,
        track: "beta"
      ).map(&:to_i)

      if existing_codes.include?(version_code.to_i)
        UI.message("Version code #{version_code} is already on Google Play open testing; skipping upload.")
        next
      end

      # Play refuses a rollout no existing user can upgrade to. Codes that only
      # ever went to Play carry no Codeberg marker, so the versionCode counter
      # cannot see them; fail here with the fix instead of letting supply
      # surface a cryptic Google API error.
      max_existing = existing_codes.max
      if max_existing && max_existing >= version_code.to_i
        UI.user_error!(
          "Google Play track 'beta' already serves versionCode #{max_existing} >= incoming #{version_code}; " \
          "no existing user could upgrade, so supply would be rejected. " \
          "Bump baseVersionCode in app/build.gradle.kts past #{max_existing}."
        )
      end
    end

    supply(
      package_name: OPENVITALS_PACKAGE_NAME,
      json_key: json_key,
      aab: aab,
      track: "beta",
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      changes_not_sent_for_review: ENV["OPENVITALS_PLAY_CHANGES_NOT_SENT_FOR_REVIEW"] == "true",
      timeout: 600
    )
  end

  desc "Upload the signed Android App Bundle directly to Google Play production with store metadata"
  lane :production do |options|
    json_key = options[:json_key] || ENV["GOOGLE_PLAY_JSON_KEY"]
    aab = options[:aab] || ENV["OPENVITALS_RELEASE_AAB"]
    version_code = options[:version_code] || ENV["OPENVITALS_VERSION_CODE"]

    UI.user_error!("json_key is required") if json_key.to_s.empty?
    UI.user_error!("aab is required") if aab.to_s.empty?

    json_key = openvitals_project_path(json_key)
    aab = openvitals_project_path(aab)

    UI.user_error!("aab does not exist: #{aab}") unless File.file?(aab)

    if version_code.to_s.length > 0
      existing_codes = google_play_track_version_codes(
        package_name: OPENVITALS_PACKAGE_NAME,
        json_key: json_key,
        track: "production"
      ).map(&:to_i)

      if existing_codes.include?(version_code.to_i)
        UI.message("Version code #{version_code} is already on Google Play production; skipping production upload.")
        next
      end

      # Same guard as open_testing: surface a downgrade as an actionable
      # failure before supply hits Play's opaque rollout error.
      max_existing = existing_codes.max
      if max_existing && max_existing >= version_code.to_i
        UI.user_error!(
          "Google Play track 'production' already serves versionCode #{max_existing} >= incoming #{version_code}; " \
          "no existing user could upgrade, so supply would be rejected. " \
          "Bump baseVersionCode in app/build.gradle.kts past #{max_existing}."
        )
      end
    end

    supply(
      package_name: OPENVITALS_PACKAGE_NAME,
      json_key: json_key,
      aab: aab,
      track: "production",
      release_status: "completed",
      metadata_path: OPENVITALS_METADATA_PATH,
      sync_image_upload: true,
      changes_not_sent_for_review: ENV["OPENVITALS_PLAY_CHANGES_NOT_SENT_FOR_REVIEW"] == "true",
      timeout: 600
    )
  end
end
